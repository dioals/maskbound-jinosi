  waitForVO: 0
  setSayDialog: {fileID: 0}
  dialogSideOverride: 2
--- !u!114 &6977981071095518070
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 20
  indentLevel: 0
  storyText: "Dasar Prabu Klana bajingan! \r\nLantas, apa yang patut kita perbuat
    sekarang ya wahai guru?!\r\n"
  description: 
  character: {fileID: 11420000}
