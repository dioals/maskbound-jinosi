  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 3
  indentLevel: 0
  storyText: "Tantangannya adalah kau harus kalahkan diriku dalam 30 detik! \r\nBagaimana
    menurutmu Sang Panji dari Daha?!"
  description: 
  character: {fileID: 11410000}
  portrait: {fileID: 21300000, guid: 474b64f74a910d745aa8a3265982c419, type: 3}
