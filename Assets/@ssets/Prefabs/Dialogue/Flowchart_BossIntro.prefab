  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 19
  indentLevel: 0
  storyText: "Dia benar Panji, Dewi Sekar Taji tidak nampak disini. \r\nGuru sudah
    mencari di seluruh penjuru istana namun tidak berhasil menemukan keberadaan Sang
    Dewi. \r\nPrabu Klana pasti telah raib membawa Sang Dewi pergi bersamanya.\r\n"
  description: 
  character: {fileID: 4505441453159308730}
  portrait: {fileID: 21300000, guid: e9cce81dfee1f0843bed7dcf37a99070, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
