  waitForVO: 0
  setSayDialog: {fileID: 0}
  dialogSideOverride: 2
--- !u!114 &7460278756028193000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 25
  indentLevel: 0
  storyText: "Engkau benar Panji! Namun sebelum itu engkau perlu menyelesaikan latihan
    terlebih dahulu. \r\nIkutlah daku ke Aras Mamungkut, engkau tidak akan bisa mengalahkan
    Prabu Klana dengan kesaktian yang engkau miliki sekarang."
  description: 
  character: {fileID: 11420000}
  portrait: {fileID: 21300000, guid: e9cce81dfee1f0843bed7dcf37a99070, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
  dialogSideOverride: 2
--- !u!114 &1954038220201931806
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
