MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 28
  indentLevel: 0
  storyText: "Prabu Klana datang kemari dengan niatan untuk meminang Dewi Sekar Taji
    namun ditolak oleh Sang Dewi. \r\nAlhasil Prabu Klana murka lalu memporak-porandakan
    istana dan menculik Sang Dewi."
  description: 
  character: {fileID: 11420000}
