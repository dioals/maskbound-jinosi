--- !u!114 &3831334556571653277
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 27
  indentLevel: 0
  storyText: "Prabu Klana kurang ajar! \r\nKita harus merebut kembali Dewi Sekar
    Taji dari genggaman si Bajingan Prabu Klana!"
  description: 
  character: {fileID: 11410000}
  portrait: {fileID: 21300000, guid: b738002221813834ab3e70c34f500a98, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
