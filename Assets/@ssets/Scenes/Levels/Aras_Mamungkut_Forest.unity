  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 47
  indentLevel: 0
  storyText: 'Kerja bagus wahai muridku!

    Sekarang lepaskan jiwa-jiwa itu, kembalikan
    pada Sang Pangreksa.'
  description: 
  character: {fileID: 1557728900}
