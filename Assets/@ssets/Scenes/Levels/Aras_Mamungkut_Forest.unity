  itemId: 48
  indentLevel: 0
  storyText: Terimakasih atas kebaikan haitmu Sang Pangreksa Topeng Pelita!
  description: 
  character: {fileID: 1557728903}
  portrait: {fileID: 21300000, guid: b738002221813834ab3e70c34f500a98, type: 3}
