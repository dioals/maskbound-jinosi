  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 42
  indentLevel: 0
  storyText: Prabu Kelana merupakan sosok yang begitu kuat menginginkan kekuatan
    dan kekuasaan, namun Sang Pangreksa tidak menghendaki altarnya untuk digunakan
    Prabu Kelana mendapatkan kekuatan yang didambakannya.
  description: 
  character: {fileID: 1557728900}
  portrait: {fileID: 21300000, guid: e9cce81dfee1f0843bed7dcf37a99070, type: 3}
