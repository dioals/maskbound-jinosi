  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 43
  indentLevel: 0
  storyText: Penolakan itu berbuah pada penyerangan pada Sang Pangreksa dan kekalahannya
    dihadapan kekuatan Prabu Kelana.
  description: 
  character: {fileID: 1557728900}
  portrait: {fileID: 21300000, guid: e9cce81dfee1f0843bed7dcf37a99070, type: 3}
