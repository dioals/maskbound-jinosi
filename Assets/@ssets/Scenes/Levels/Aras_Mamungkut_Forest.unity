  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 50
  indentLevel: 0
  storyText: 'Akulah Sang Pangreksa Topeng Pelita.

    Wujud dan namaku berubah
    karena ulah Prabu Kelana.

    Namun kini pecahan jiwaku tlah kembali.'
  description: 
  character: {fileID: 1484667754}
  portrait: {fileID: 21300000, guid: b738002221813834ab3e70c34f500a98, type: 3}
