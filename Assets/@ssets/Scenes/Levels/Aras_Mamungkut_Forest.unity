  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 51
  indentLevel: 0
  storyText: 'Aku tlah tenang.

    Engkau ku perbolehkan memakai altarku.

    Niscaya
    engkau akan memperoleh kesaktian untuk menandingi Prabu Kelana.'
  description: 
  character: {fileID: 1484667754}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
