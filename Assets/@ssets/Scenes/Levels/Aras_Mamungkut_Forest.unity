  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 44
  indentLevel: 0
  storyText: 'Engkau benar wahai muridku.

    Karena itulah sekarang daku ingin
    engkau mengumpulkan wasesa Sang Pangreksa.'
  description: 
  character: {fileID: 1557728900}
