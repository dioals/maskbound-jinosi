  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 38
  indentLevel: 0
  storyText: Siapa yang tega melakukan hal itu pada Sang Pangreksa?
  description: 
  character: {fileID: 1557728903}
  portrait: {fileID: 21300000, guid: b738002221813834ab3e70c34f500a98, type: 3}
  voiceOverClip: {fileID: 0}
