  dialogSideOverride: 2
--- !u!114 &1557728915
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1557728901}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 46
  indentLevel: 0
  storyText: 'Hancurkan artefak yang mengurung mereka dan kembalikan mereka pada
    Sang Pangreksa.

    Lekasnya Sang Pangreksa akan tenang dan engkau dapat bersemedi
    di altar ini.'
  description: 
  character: {fileID: 1557728900}
  portrait: {fileID: 21300000, guid: e9cce81dfee1f0843bed7dcf37a99070, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
  dialogSideOverride: 2
